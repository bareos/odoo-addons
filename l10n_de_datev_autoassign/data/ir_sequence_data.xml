<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            noupdate="1": Sequenz wird nur beim ersten Installieren angelegt.
            Manuelle Änderungen in der UI (Startnummer etc.) bleiben erhalten.
        -->
        <record id="seq_l10n_de_datev_identifier_customer" model="ir.sequence">
            <field name="name">DATEV Debitorennummer</field>
            <field name="code">l10n_de_datev_identifier_customer_sequence</field>
            <field name="prefix"/>
            <field name="suffix"/>
            <field name="padding">0</field>
            <field name="number_next">10000</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
            <!-- company_id=False → gilt für alle Mandanten; auf True setzen für mandantenspezifische Sequenz -->
        </record>
    </data>
</odoo>
