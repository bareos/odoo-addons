<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_datev_autoassign" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.datev.autoassign</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="DATEV" name="datev_autoassign">
                    <setting id="datev_autoassign_settings" help="Beim Bestätigen einer Ausgangsrechnung wird dem Kunden automatisch eine DATEV-Debitorennummer zugewiesen, falls noch keine vorhanden ist.">
                        <field name="datev_auto_assign_customer_identifier"/>
                        <div class="content-group" invisible="datev_auto_assign_customer_identifier != True">
                            <div class="row">
                                <label for="datev_customer_identifier_next" string="Next Number"/>
                                <field name="datev_customer_identifier_next"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
